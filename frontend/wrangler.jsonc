{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feynman",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www.feynman-technique.com", "custom_domain": true },
    // Keep the proxied apex DNS/TLS binding for the zone's 301 Redirect Rule.
    { "pattern": "feynman-technique.com", "custom_domain": true }
  ]
}
