{
  "name": "@feynman/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:social-card": "node scripts/social-card.mjs",
    "dev": "pnpm generate && vite --host 127.0.0.1",
    "typecheck": "pnpm generate && tsc --noEmit",
    "check:lab": "pnpm generate && vitest run",
    "test": "pnpm generate && vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:workers": "wrangler dev --ip 127.0.0.1 --port 4173 --local",
    "deploy:workers": "wrangler deploy",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "ajv": "8.17.1",
    "katex": "0.16.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/katex": "0.16.7",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "2.16.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "marked": "16.4.1",
    "sanitize-html": "2.17.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wrangler": "4.149.0"
  }
}
