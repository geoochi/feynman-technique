{
  "name": "@feynman/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:social-card": "node scripts/social-card.mjs",
    "dev": "pnpm generate && next dev --hostname 127.0.0.1",
    "typecheck": "pnpm generate && next typegen && tsc --noEmit",
    "check:lab": "pnpm generate && vitest run",
    "test": "pnpm generate && vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm generate && next build && tsx scripts/finalize-next.ts && tsx scripts/check-export.ts",
    "preview": "wrangler dev --ip 127.0.0.1 --port 4173 --local",
    "preview:workers": "pnpm preview",
    "deploy:workers": "wrangler deploy",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "ajv": "8.20.0",
    "katex": "0.19.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "0.186.0",
    "marked": "18.1.1",
    "sanitize-html": "2.18.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  }
}
