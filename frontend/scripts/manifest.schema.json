{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "version",
    "sdkRange",
    "title",
    "summary",
    "subjects",
    "levels",
    "tags",
    "learningObjectives",
    "prerequisites",
    "estimatedMinutes",
    "layout",
    "theme",
    "renderer",
    "entry",
    "parameterSchema",
    "snapshotSchema",
    "locales",
    "lessons",
    "preview",
    "authors",
    "licenses",
    "capabilities",
    "modelAssumptions",
    "references",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
    "sdkRange": { "const": "^0.1.0" },
    "title": { "$ref": "#/definitions/translation" },
    "summary": { "$ref": "#/definitions/translation" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["math", "physics", "geography"] }
    },
    "levels": { "$ref": "#/definitions/strings" },
    "tags": { "$ref": "#/definitions/strings" },
    "learningObjectives": { "$ref": "#/definitions/strings" },
    "prerequisites": { "$ref": "#/definitions/strings" },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
    "layout": { "const": "lesson" },
    "theme": { "enum": ["paper", "astronomy", "instrument"] },
    "renderer": { "enum": ["svg", "canvas", "three"] },
    "entry": { "const": "view.tsx" },
    "parameterSchema": { "const": "parameters.schema.json" },
    "snapshotSchema": { "const": "snapshot.schema.json" },
    "preview": { "const": "preview.svg" },
    "locales": {
      "type": "array",
      "items": { "const": "zh-CN" },
      "minItems": 1,
      "maxItems": 1
    },
    "lessons": {
      "type": "object",
      "required": ["zh-CN"],
      "additionalProperties": false,
      "properties": { "zh-CN": { "const": "lesson.zh-CN.md" } }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "licenses": {
      "type": "object",
      "required": ["code", "content"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["network", "audio"],
      "additionalProperties": false,
      "properties": {
        "network": { "const": false },
        "audio": { "const": false }
      }
    },
    "modelAssumptions": { "$ref": "#/definitions/strings" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "status": { "enum": ["experimental", "reviewed", "draft"] }
  },
  "definitions": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "translation": {
      "type": "object",
      "required": ["zh-CN"],
      "additionalProperties": false,
      "properties": { "zh-CN": { "type": "string", "minLength": 1 } }
    }
  }
}
