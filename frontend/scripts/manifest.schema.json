{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "version",
    "sdkRange",
    "title",
    "summary",
    "subjects",
    "levels",
    "tags",
    "learningObjectives",
    "prerequisites",
    "estimatedMinutes",
    "layout",
    "theme",
    "renderer",
    "entry",
    "parameterSchema",
    "snapshotSchema",
    "locales",
    "lessons",
    "preview",
    "authors",
    "licenses",
    "capabilities",
    "modelAssumptions",
    "references",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "sdkRange": {
      "const": "^0.1.0"
    },
    "title": {
      "$ref": "#/definitions/translation"
    },
    "summary": {
      "$ref": "#/definitions/translation"
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "experiment": {
          "$ref": "#/definitions/seoCopy"
        },
        "lesson": {
          "$ref": "#/definitions/seoCopy"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["math", "physics", "geography"]
      }
    },
    "levels": {
      "$ref": "#/definitions/strings"
    },
    "tags": {
      "$ref": "#/definitions/translatedStrings"
    },
    "learningObjectives": {
      "$ref": "#/definitions/translatedStrings"
    },
    "prerequisites": {
      "$ref": "#/definitions/translatedStrings"
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "layout": {
      "const": "lesson"
    },
    "theme": {
      "enum": ["paper", "astronomy", "instrument"]
    },
    "renderer": {
      "enum": ["svg", "canvas", "three"]
    },
    "entry": {
      "const": "view.tsx"
    },
    "parameterSchema": {
      "const": "parameters.schema.json"
    },
    "snapshotSchema": {
      "const": "snapshot.schema.json"
    },
    "preview": {
      "const": "preview.svg"
    },
    "locales": {
      "type": "array",
      "items": {
        "enum": ["en", "zh-CN", "ja"]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "lessons": {
      "type": "object",
      "required": ["en", "zh-CN", "ja"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "const": "lesson.en.md"
        },
        "zh-CN": {
          "const": "lesson.zh-CN.md"
        },
        "ja": {
          "const": "lesson.ja.md"
        }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "licenses": {
      "type": "object",
      "required": ["code", "content"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["network", "audio"],
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": false
        },
        "audio": {
          "const": false
        }
      }
    },
    "modelAssumptions": {
      "$ref": "#/definitions/translatedStrings"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "status": {
      "enum": ["experimental", "reviewed", "draft"]
    }
  },
  "definitions": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "translation": {
      "type": "object",
      "required": ["en", "zh-CN", "ja"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "translatedStrings": {
      "type": "object",
      "required": ["en", "zh-CN", "ja"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/definitions/strings"
        },
        "zh-CN": {
          "$ref": "#/definitions/strings"
        },
        "ja": {
          "$ref": "#/definitions/strings"
        }
      }
    },
    "seoCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/seoTranslation"
        },
        "description": {
          "$ref": "#/definitions/seoTranslation"
        }
      }
    },
    "seoTranslation": {
      "allOf": [
        {
          "$ref": "#/definitions/translation"
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "pattern": "\\S"
            },
            "zh-CN": {
              "type": "string",
              "pattern": "\\S"
            },
            "ja": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
